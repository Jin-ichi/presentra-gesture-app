{
  "name": "presentra-gesture-app",
  "version": "1.1.0",
  "description": "Hand gesture controller for presentations",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --ext js,css,html --exec electron .",
    "dist": "electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.jean.presentra",
    "productName": "Presentra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!landing-page/**",
      "!dist/**",
      "!**/*.md",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "node_modules/@mediapipe/hands",
        "to": "mediapipe-hands",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/presentra-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [],
  "author": "Jean Pierre Armas",
  "license": "ISC",
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true
  }
}